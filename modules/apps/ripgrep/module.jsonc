{
  // Config Module: ripgrep
  // ripgrep reads only the file named by RIPGREP_CONFIG_PATH. Endstate captures
  // reviewed user-config conventions on each supported platform.

  "moduleSchemaVersion": 3,
  "id": "apps.ripgrep",
  "displayName": "ripgrep",
  "sensitivity": "low",

  "platforms": {
    "windows": {
      "realization": "endstate-restore",
      "matches": {
        "winget": ["BurntSushi.ripgrep.MSVC"],
        "exe": ["rg.exe"],
        "uninstallDisplayName": ["^ripgrep"]
      },
      "verify": [
        { "type": "command-exists", "command": "rg" }
      ],
      "restore": [
        {
          "type": "copy",
          "source": "./payload/apps/ripgrep/.ripgreprc",
          "target": "${home}/.ripgreprc",
          "backup": true,
          "optional": true
        },
        {
          "type": "copy",
          "source": "./payload/apps/ripgrep/config",
          "target": "${windows.appdata}/ripgrep/config",
          "backup": true,
          "optional": true
        }
      ],
      "capture": {
        "files": [
          { "source": "${home}/.ripgreprc", "dest": "apps/ripgrep/.ripgreprc", "optional": true },
          { "source": "${windows.appdata}/ripgrep/config", "dest": "apps/ripgrep/config", "optional": true }
        ],
        "excludeGlobs": ["**/*.log"]
      }
    },

    "linux": {
      "realization": "endstate-restore",
      "matches": {
        "pathExists": [
          "${home}/.ripgreprc",
          "${xdg.config}/ripgrep/config",
          "${xdg.config}/ripgrep/ripgreprc"
        ]
      },
      "verify": [
        {
          "type": "command-exists",
          "command": "rg"
        }
      ],
      "homeManagerAdapter": {
        "id": "ripgrep",
        "reviewFingerprint": "d60ee9bd5e8317d2c9e32dc47cf82798e275cf99a397b36ebbcbcfa3801514e2",
        "configSetId": "default",
        "generationId": "g2"
      },
      "config": {
        "instanceDetectors": [
          {
            "id": "default",
            "type": "path",
            "glob": "${home}"
          }
        ],
        "sets": [
          {
            "id": "default",
            "generations": [
              {
                "id": "g2",
                "order": 2,
                "capture": {
                  "files": [
                    {
                      "source": "${home}/.ripgreprc",
                      "dest": "apps/ripgrep/.ripgreprc",
                      "optional": true
                    },
                    {
                      "source": "${xdg.config}/ripgrep/config",
                      "dest": "apps/ripgrep/config",
                      "optional": true
                    },
                    {
                      "source": "${xdg.config}/ripgrep/ripgreprc",
                      "dest": "apps/ripgrep/ripgreprc",
                      "optional": true
                    }
                  ],
                  "excludeGlobs": [
                    "**/*.log"
                  ]
                },
                "restore": [
                  {
                    "type": "copy",
                    "source": "apps/ripgrep/.ripgreprc",
                    "target": "${home}/.ripgreprc",
                    "backup": true,
                    "optional": true
                  },
                  {
                    "type": "copy",
                    "source": "apps/ripgrep/config",
                    "target": "${xdg.config}/ripgrep/config",
                    "backup": true,
                    "optional": true
                  },
                  {
                    "type": "copy",
                    "source": "apps/ripgrep/ripgreprc",
                    "target": "${xdg.config}/ripgrep/ripgreprc",
                    "backup": true,
                    "optional": true
                  }
                ],
                "validate": [
                  {
                    "type": "settings-codec",
                    "path": "apps/ripgrep/.ripgreprc",
                    "codec": "ripgrep-portable-arguments-v1",
                    "optional": true
                  },
                  {
                    "type": "settings-codec",
                    "path": "apps/ripgrep/config",
                    "codec": "ripgrep-portable-arguments-v1",
                    "optional": true
                  },
                  {
                    "type": "settings-codec",
                    "path": "apps/ripgrep/ripgreprc",
                    "codec": "ripgrep-portable-arguments-v1",
                    "optional": true
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },

  "notes": "Linux captures only reviewed portable preference arguments. Unsupported arguments make the complete file unavailable. Windows retains its existing file capture. ripgrep reads the path selected by RIPGREP_CONFIG_PATH; Endstate does not configure that environment variable."
}

{
  // Config Module: ripgrep
  // ripgrep reads only the file named by RIPGREP_CONFIG_PATH. Endstate captures
  // the two established user-config conventions on each supported platform.

  "moduleSchemaVersion": 3,
  "id": "apps.ripgrep",
  "displayName": "ripgrep",
  "sensitivity": "low",

  "platforms": {
    "windows": {
      "realization": "endstate-restore",
      "matches": {
        "winget": ["BurntSushi.ripgrep.MSVC"],
        "exe": ["rg.exe"],
        "uninstallDisplayName": ["^ripgrep"]
      },
      "verify": [
        { "type": "command-exists", "command": "rg" }
      ],
      "restore": [
        {
          "type": "copy",
          "source": "./payload/apps/ripgrep/.ripgreprc",
          "target": "${home}/.ripgreprc",
          "backup": true,
          "optional": true
        },
        {
          "type": "copy",
          "source": "./payload/apps/ripgrep/config",
          "target": "${windows.appdata}/ripgrep/config",
          "backup": true,
          "optional": true
        }
      ],
      "capture": {
        "files": [
          { "source": "${home}/.ripgreprc", "dest": "apps/ripgrep/.ripgreprc", "optional": true },
          { "source": "${windows.appdata}/ripgrep/config", "dest": "apps/ripgrep/config", "optional": true }
        ],
        "excludeGlobs": ["**/*.log"]
      }
    },

    "linux": {
      "realization": "endstate-restore",
      "matches": {
        "pathExists": [
          "${home}/.ripgreprc",
          "${xdg.config}/ripgrep/config"
        ]
      },
      "verify": [
        { "type": "command-exists", "command": "rg" }
      ],
      "restore": [
        {
          "type": "copy",
          "source": "./payload/apps/ripgrep/.ripgreprc",
          "target": "${home}/.ripgreprc",
          "backup": true,
          "optional": true
        },
        {
          "type": "copy",
          "source": "./payload/apps/ripgrep/config",
          "target": "${xdg.config}/ripgrep/config",
          "backup": true,
          "optional": true
        }
      ],
      "capture": {
        "files": [
          { "source": "${home}/.ripgreprc", "dest": "apps/ripgrep/.ripgreprc", "optional": true },
          { "source": "${xdg.config}/ripgrep/config", "dest": "apps/ripgrep/config", "optional": true }
        ],
        "excludeGlobs": ["**/*.log"]
      }
    }
  },

  "notes": "Captures ripgrep defaults, type definitions, and glob rules from the dominant ~/.ripgreprc convention and the alternate platform config location. ripgrep has no built-in config path; users point RIPGREP_CONFIG_PATH at one of these files. No credentials are involved."
}

{
  // Config Module: CCleaner
  // Provides verify/capture/restore configuration for CCleaner (Piriform)
  // Settings stored in HKCU\Software\Piriform\CCleaner (cleaning options, include/exclude rules)
  // Excludes registration name + license key

  "id": "apps.ccleaner",
  "displayName": "CCleaner",
  "sensitivity": "low",

  "matches": {
    "winget": ["Piriform.CCleaner"],
    "exe": ["CCleaner64.exe", "CCleaner.exe"],
    "uninstallDisplayName": ["^CCleaner"]
  },

  "verify": [
    { "type": "registry-key-exists", "path": "HKCU:\\Software\\Piriform\\CCleaner" }
  ],

  "restore": [
    {
      // Cleaning options, Include#/Exclude# custom rules, window/UI prefs
      "type": "registry-import",
      "source": "./payload/apps/ccleaner/CCleaner.reg",
      "target": "HKCU\\Software\\Piriform\\CCleaner",
      "backup": true,
      "optional": true
    }
  ],

  "capture": {
    "files": [],
    "registryKeys": [
      { "key": "HKCU\\Software\\Piriform\\CCleaner", "dest": "apps/ccleaner/CCleaner.reg", "optional": true }
    ]
  },

  "secrets": {
    // String coordinates keep older engines failing closed on this capture;
    // registryValues states the same two values precisely.
    "files": [
      "HKCU\\Software\\Piriform\\CCleaner\\Name",
      "HKCU\\Software\\Piriform\\CCleaner\\License"
    ],
    "registryValues": [
      { "key": "HKCU\\Software\\Piriform\\CCleaner", "valueName": "Name" },
      { "key": "HKCU\\Software\\Piriform\\CCleaner", "valueName": "License" }
    ],
    "warning": "CCleaner Professional keeps its registration name and license key in the settings key. Endstate leaves both values out of the capture, so re-enter your license after a restore.",
    "restorer": "warn-only"
  },

  "notes": "Captures CCleaner settings from HKCU\\Software\\Piriform\\CCleaner: cleaning options, custom Include#/Exclude# rules, secure-delete method, and window/UI preferences. The registration Name/License values share this key; capture filters them out, so re-enter the license after a restore. Settings can alternatively live in ccleaner.ini in portable mode, which is not covered here. Confidence: medium - registry key and value structure confirmed by the winreg-kb knowledge base; license values share the key so are flagged sensitive."
}

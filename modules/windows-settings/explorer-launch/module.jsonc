{
  // Config Module: Windows Explorer — start location
  // Value-level Windows OS-settings tier. Single value under Explorer\Advanced.
  // Fully reversible (an absent value is created, then deleted on revert).

  "id": "windows-settings.explorer-launch",
  "displayName": "Windows Explorer: start location",
  "sensitivity": "low",

  "matches": {
    "pathExists": ["%WINDIR%\\explorer.exe"]
  },

  "capture": {
    "files": [],
    "registryValues": [
      { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "LaunchTo", "optional": true }
    ]
  },

  "restore": [
    { "type": "registry-set", "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "LaunchTo", "reason": "File Explorer start folder" }
  ],

  "verify": [
    { "type": "registry-value-equals", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "LaunchTo" }
  ],

  "notes": "Explorer\\Advanced\\LaunchTo selects the folder File Explorer opens to (1 = This PC, 2 = Quick Access or Home). It is often absent on a fresh install, which means the Windows default. Capture records the old PC's value; restore writes it, and a value that was not set on the old PC is not restored. Value-level so co-resident Advanced values are untouched. HKCU-only; fully reversible."
}

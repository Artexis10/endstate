{
  // Config Module: Windows theme — light or dark mode
  // Value-level Windows OS-settings tier (not a per-app module).
  // Captures whether apps and the system UI use the light or dark theme on the
  // old PC and restores those captured values. Fully reversible: restore backs
  // up the prior value before overwriting; verify asserts the restored data.

  "id": "windows-settings.personalization",
  "displayName": "Windows theme: light or dark mode",
  "sensitivity": "low",

  "matches": {
    // OS-settings modules always apply on Windows; key off a path that is
    // guaranteed present rather than an installed app.
    "pathExists": ["%WINDIR%\\explorer.exe"]
  },

  "capture": {
    "files": [],
    "registryValues": [
      { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "valueName": "AppsUseLightTheme", "optional": true },
      { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "valueName": "SystemUsesLightTheme", "optional": true }
    ]
  },

  "restore": [
    {
      "type": "registry-set",
      "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
      "valueName": "AppsUseLightTheme",
      "reason": "Default app mode (light or dark)"
    },
    {
      "type": "registry-set",
      "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
      "valueName": "SystemUsesLightTheme",
      "reason": "Default Windows mode (light or dark)"
    }
  ],

  "verify": [
    { "type": "registry-value-equals", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "valueName": "AppsUseLightTheme" },
    { "type": "registry-value-equals", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "valueName": "SystemUsesLightTheme" }
  ],

  "notes": "The theme is controlled by HKCU\\...\\Themes\\Personalize: AppsUseLightTheme (apps) and SystemUsesLightTheme (system UI), REG_DWORD where 1 is light and 0 is dark. Capture records the old PC's values; restore writes them, and a value that was not set on the old PC is not restored. Value-level (registry-set), so co-resident values under the same key (e.g. ColorPrevalence, EnableTransparency) are never touched. HKCU-only; fully reversible."
}

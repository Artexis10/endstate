{
  // Config Module: Windows Explorer — file extensions and hidden files
  // Value-level Windows OS-settings tier (not a per-app module).
  // Captures whether Explorer shows file extensions and hidden files on the old
  // PC and restores those captured values. Fully reversible.

  "id": "windows-settings.explorer",
  "displayName": "Windows Explorer: file extensions and hidden files",
  "sensitivity": "low",

  "matches": {
    "pathExists": ["%WINDIR%\\explorer.exe"]
  },

  "capture": {
    "files": [],
    "registryValues": [
      { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "HideFileExt", "optional": true },
      { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "Hidden", "optional": true }
    ]
  },

  "restore": [
    {
      "type": "registry-set",
      "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "valueName": "HideFileExt",
      "reason": "File name extensions in File Explorer"
    },
    {
      "type": "registry-set",
      "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "valueName": "Hidden",
      "reason": "Hidden items in File Explorer"
    }
  ],

  "verify": [
    { "type": "registry-value-equals", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "HideFileExt" },
    { "type": "registry-value-equals", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "Hidden" }
  ],

  "notes": "Explorer view preferences live under HKCU\\...\\Explorer\\Advanced: HideFileExt controls file extension visibility and Hidden controls hidden file visibility. Capture records the old PC's type and data for each value; restore writes those captured values, and a value that was not set on the old PC is not restored. Value-level (registry-set) so co-resident Advanced values (TaskbarAl, ShowSuperHidden, etc.) are never clobbered. HKCU-only; fully reversible. Note: a running Explorer may need a restart/refresh to reflect the change."
}

{
  // Config Module: Windows taskbar — alignment
  // Value-level Windows OS-settings tier (not a per-app module).
  // Captures the Windows 11 taskbar alignment value on the old PC and restores
  // that captured value under the Explorer\Advanced key. Fully reversible.

  "id": "windows-settings.taskbar",
  "displayName": "Windows taskbar: alignment",
  "sensitivity": "low",

  "matches": {
    "pathExists": ["%WINDIR%\\explorer.exe"]
  },

  "capture": {
    "files": [],
    "registryValues": [
      { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "TaskbarAl", "optional": true }
    ]
  },

  "restore": [
    {
      "type": "registry-set",
      "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "valueName": "TaskbarAl",
      "reason": "Windows 11 taskbar alignment (0 = left, 1 = center)"
    }
  ],

  "verify": [
    { "type": "registry-value-equals", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "TaskbarAl" }
  ],

  "notes": "Windows 11 taskbar alignment is HKCU\\...\\Explorer\\Advanced\\TaskbarAl (REG_DWORD): 0 = left, 1 = center (default). The value may be absent on a default install, which means center. Capture records the old PC's value; restore writes it, and a value that was not set on the old PC is not restored. Value-level (registry-set) so it never clobbers co-resident Advanced values. HKCU-only; fully reversible — revert deletes the value when it was absent before, otherwise restores the prior data."
}

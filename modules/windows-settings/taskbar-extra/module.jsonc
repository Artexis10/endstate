{
  // Config Module: Windows taskbar — search, Task View and clock seconds
  // Value-level Windows OS-settings tier. Values under the Search and Explorer\Advanced keys.
  // Fully reversible (absent values are created, then deleted on revert).

  "id": "windows-settings.taskbar-extra",
  "displayName": "Windows taskbar: search, Task View and clock seconds",
  "sensitivity": "low",

  "matches": {
    "pathExists": ["%WINDIR%\\explorer.exe"]
  },

  "capture": {
    "files": [],
    "registryValues": [
      { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Search", "valueName": "SearchboxTaskbarMode", "optional": true },
      { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "ShowTaskViewButton", "optional": true },
      { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "ShowSecondsInSystemClock", "optional": true }
    ]
  },

  "restore": [
    { "type": "registry-set", "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Search", "valueName": "SearchboxTaskbarMode", "reason": "How the taskbar shows search" },
    { "type": "registry-set", "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "ShowTaskViewButton", "reason": "Task View button visibility" },
    { "type": "registry-set", "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "ShowSecondsInSystemClock", "reason": "Seconds in the system-tray clock" }
  ],

  "verify": [
    { "type": "registry-value-equals", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Search", "valueName": "SearchboxTaskbarMode" },
    { "type": "registry-value-equals", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "ShowTaskViewButton" },
    { "type": "registry-value-equals", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "valueName": "ShowSecondsInSystemClock" }
  ],

  "notes": "Taskbar and clock preferences, all REG_DWORD on a standard install: SearchboxTaskbarMode (Search key) selects how the taskbar shows search; ShowTaskViewButton and ShowSecondsInSystemClock (Explorer\\Advanced) control the Task View button and clock seconds. Capture records the old PC's values; restore writes them, and a value that was not set on the old PC is not restored. Value-level (registry-set) so co-resident Advanced values are never clobbered. HKCU-only; fully reversible. A running Explorer may need a restart to reflect the change."
}

{
  // Config Module: Windows privacy — advertising ID and Start suggestions
  // Value-level Windows OS-settings tier (not a per-app module). Fully reversible.

  "id": "windows-settings.privacy",
  "displayName": "Windows privacy: advertising ID and Start suggestions",
  "sensitivity": "low",

  "matches": {
    "pathExists": ["%WINDIR%\\explorer.exe"]
  },

  "capture": {
    "files": [],
    "registryValues": [
      { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo", "valueName": "Enabled", "optional": true },
      { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "valueName": "SystemPaneSuggestionsEnabled", "optional": true },
      { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "valueName": "SilentInstalledAppsEnabled", "optional": true }
    ]
  },

  "restore": [
    { "type": "registry-set", "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo", "valueName": "Enabled", "reason": "Advertising ID for personalized ads" },
    { "type": "registry-set", "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "valueName": "SystemPaneSuggestionsEnabled", "reason": "Suggestions in Start" },
    { "type": "registry-set", "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "valueName": "SilentInstalledAppsEnabled", "reason": "Automatic installs of promoted apps" }
  ],

  "verify": [
    { "type": "registry-value-equals", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo", "valueName": "Enabled" },
    { "type": "registry-value-equals", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "valueName": "SystemPaneSuggestionsEnabled" },
    { "type": "registry-value-equals", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "valueName": "SilentInstalledAppsEnabled" }
  ],

  "notes": "Privacy toggles under HKCU: AdvertisingInfo\\Enabled controls the per-user advertising ID; ContentDeliveryManager\\SystemPaneSuggestionsEnabled and SilentInstalledAppsEnabled control Start-menu suggestions and silently promoted app installs. All REG_DWORD on a standard install. Capture records the old PC's values; restore writes them, and a value that was not set on the old PC is not restored. Value-level (registry-set) so co-resident values are never clobbered. HKCU-only; fully reversible (prior values backed up, restore-or-delete on revert)."
}

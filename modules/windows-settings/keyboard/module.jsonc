{
  // Config Module: Windows keyboard — repeat delay and rate
  // Value-level Windows OS-settings tier. Values under HKCU\Control Panel\Keyboard.
  // Fully reversible.

  "id": "windows-settings.keyboard",
  "displayName": "Windows keyboard: repeat delay and rate",
  "sensitivity": "low",

  "matches": {
    "pathExists": ["%WINDIR%\\explorer.exe"]
  },

  "capture": {
    "files": [],
    "registryValues": [
      { "key": "HKCU\\Control Panel\\Keyboard", "valueName": "KeyboardDelay", "optional": true },
      { "key": "HKCU\\Control Panel\\Keyboard", "valueName": "KeyboardSpeed", "optional": true }
    ]
  },

  "restore": [
    { "type": "registry-set", "key": "HKCU\\Control Panel\\Keyboard", "valueName": "KeyboardDelay", "reason": "Delay before a held key starts repeating" },
    { "type": "registry-set", "key": "HKCU\\Control Panel\\Keyboard", "valueName": "KeyboardSpeed", "reason": "Rate at which a held key repeats" }
  ],

  "verify": [
    { "type": "registry-value-equals", "path": "HKCU\\Control Panel\\Keyboard", "valueName": "KeyboardDelay" },
    { "type": "registry-value-equals", "path": "HKCU\\Control Panel\\Keyboard", "valueName": "KeyboardSpeed" }
  ],

  "notes": "Keyboard repeat settings under HKCU\\Control Panel\\Keyboard: KeyboardDelay (0-3, delay before repeat) and KeyboardSpeed (0-31, repeat rate), both REG_SZ on a standard install. Capture records the old PC's values; restore writes them, and a value that was not set on the old PC is not restored. HKCU-only; fully reversible (prior values backed up). Applies on next sign-in or SystemParametersInfo refresh."
}

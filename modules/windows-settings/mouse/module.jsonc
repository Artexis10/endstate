{
  // Config Module: Windows mouse — pointer acceleration
  // Value-level Windows OS-settings tier. Values under HKCU\Control Panel\Mouse.
  // Fully reversible.

  "id": "windows-settings.mouse",
  "displayName": "Windows mouse: pointer acceleration",
  "sensitivity": "low",

  "matches": {
    "pathExists": ["%WINDIR%\\explorer.exe"]
  },

  "capture": {
    "files": [],
    "registryValues": [
      { "key": "HKCU\\Control Panel\\Mouse", "valueName": "MouseSpeed", "optional": true },
      { "key": "HKCU\\Control Panel\\Mouse", "valueName": "MouseThreshold1", "optional": true },
      { "key": "HKCU\\Control Panel\\Mouse", "valueName": "MouseThreshold2", "optional": true }
    ]
  },

  "restore": [
    { "type": "registry-set", "key": "HKCU\\Control Panel\\Mouse", "valueName": "MouseSpeed", "reason": "Pointer acceleration (Enhance pointer precision)" },
    { "type": "registry-set", "key": "HKCU\\Control Panel\\Mouse", "valueName": "MouseThreshold1", "reason": "First pointer acceleration threshold" },
    { "type": "registry-set", "key": "HKCU\\Control Panel\\Mouse", "valueName": "MouseThreshold2", "reason": "Second pointer acceleration threshold" }
  ],

  "verify": [
    { "type": "registry-value-equals", "path": "HKCU\\Control Panel\\Mouse", "valueName": "MouseSpeed" },
    { "type": "registry-value-equals", "path": "HKCU\\Control Panel\\Mouse", "valueName": "MouseThreshold1" },
    { "type": "registry-value-equals", "path": "HKCU\\Control Panel\\Mouse", "valueName": "MouseThreshold2" }
  ],

  "notes": "Pointer acceleration ('Enhance pointer precision') is controlled by MouseSpeed, MouseThreshold1 and MouseThreshold2 under HKCU\\Control Panel\\Mouse, all REG_SZ on a standard install. Capture records the old PC's values; restore writes them, and a value that was not set on the old PC is not restored. HKCU-only; fully reversible (prior values backed up). Takes effect on next sign-in or SystemParametersInfo refresh."
}

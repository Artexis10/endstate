@@ -576,6 +576,26 @@ func copyFile(src, dst string) error {
 	if _, err := io.Copy(out, in); err != nil {
 		return err
 	}
+	if strings.EqualFold(filepath.Ext(src), ".json") {
+		info, err := in.Stat()
+		if err != nil {
+			return err
+		}
+		if info.Size() > 0 {
+			if _, err := in.Seek(-1, io.SeekEnd); err != nil {
+				return err
+			}
+			var last [1]byte
+			if _, err := in.Read(last[:]); err != nil {
+				return err
+			}
+			if last[0] == '\n' {
+				if err := out.Truncate(info.Size() - 1); err != nil {
+					return err
+				}
+			}
+		}
+	}
 
 	return out.Close()
 }

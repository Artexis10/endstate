    {
      "id": "git",
      "program": "git",
      "displayName": "Git",
      "packageId": "git",
      "moduleId": "apps.git",
      "disposition": "curated-codec",
      "codec": "git-config-safe-v1",
      "probe": {
        "values": {
          "programs.git.attributes": [
            "*.pdf diff=pdf"
          ],
          "programs.git.ignores": [
            "*.tmp"
          ],
          "programs.git.settings": {
            "user": {
              "name": "Endstate Probe"
            }
          }
        },
        "targets": [
          "${xdg.config}/git/attributes",
          "${xdg.config}/git/config",
          "${xdg.config}/git/ignore"
        ]
      },
      "options": [
        {
          "name": "programs.git.attributes",
          "type": "list of string",
          "declarations": [
            "modules/programs/git.nix"
          ]
        },
        {
          "name": "programs.git.ignores",
          "type": "list of string",
          "declarations": [
            "modules/programs/git.nix"
          ]
        },
        {
          "name": "programs.git.settings",
          "type": "(attribute set of attribute set of (string or boolean or signed integer or list of (string or boolean or signed integer) or attribute set of (string or boolean or signed integer or list of (string or boolean or signed integer)))) or list of attribute set of attribute set of (string or boolean or signed integer or list of (string or boolean or signed integer) or attribute set of (string or boolean or signed integer or list of (string or boolean or signed integer)))",
          "declarations": [
            "modules/programs/git.nix"
          ]
        }
      ],
      "targets": [
        {
          "coordinate": "${home}/.gitattributes",
          "optional": true
        },
        {
          "coordinate": "${home}/.gitconfig",
          "optional": true
        },
        {
          "coordinate": "${xdg.config}/git/attributes",
          "optional": true
        },
        {
          "coordinate": "${xdg.config}/git/config",
          "optional": true
        },
        {
          "coordinate": "${xdg.config}/git/ignore",
          "optional": true
        }
      ],
      "sourceHashes": {
        "modules/programs/git.nix": "d6bd012795457bda5cc1672ea229124f88ad2944e96fd9b87d723f42841a06b8"
      },
      "reviewFingerprint": "4192a7a9af103afc1603cff0ae593f60190ee8c8567305c42f9cc7c685fab8ca"
    },
    {
      "id": "helix",
      "program": "helix",
      "displayName": "Helix",
      "packageId": "helix",
      "moduleId": "apps.helix",
      "disposition": "file-roundtrip",
      "codec": "bounded-regular-file-v1",
      "probe": {
        "values": {
          "programs.helix.extraConfig": "# endstate target probe",
          "programs.helix.ignores": [
            ".git"
          ],
          "programs.helix.languages": {
            "language": [
              {
                "auto-format": false,

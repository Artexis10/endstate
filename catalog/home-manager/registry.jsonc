      "id": "yazi",
      "program": "yazi",
      "displayName": "Yazi",
      "packageId": "yazi",
      "moduleId": "apps.yazi",
      "disposition": "file-roundtrip",
      "codec": "bounded-regular-file-v1",
      "probe": {
        "values": {
          "programs.yazi.keymap": {
            "mgr": {
              "prepend_keymap": [
                {
                  "on": [
                    "q"
                  ],
                  "run": "quit"
                }
              ]
            }
          },
          "programs.yazi.settings": {
            "mgr": {
              "show_hidden": false
            }
          },
          "programs.yazi.theme": {
            "filetype": {
              "rules": [
                {
                  "fg": "#ffffff",
                  "mime": "text/*"
                }
              ]
            }
          },
          "programs.yazi.vfs": {
            "services": {
              "endstate-probe": {
                "host": "127.0.0.1",
                "type": "sftp"
              }
            }
          }
        }
      },
      "options": [
        {
          "name": "programs.yazi.keymap",

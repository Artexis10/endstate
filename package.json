{
  "name": "endstate",
  "version": "0.0.0",
  "private": true,
  "description": "Declarative system provisioning and recovery tool",
  "scripts": {
    "hooks:install": "lefthook install",
    "openspec:list": "openspec list",
    "openspec:list:specs": "openspec list --specs",
    "openspec:validate": "node scripts/openspec_strict_gate.mjs -- node node_modules/@fission-ai/openspec/bin/openspec.js",
    "openspec:validate:ci": "pwsh -NoProfile -File scripts/openspec_validate.ps1",
    "version:show": "node -p \"require('./.release-please-manifest.json')['.']\"",
    "version:schema": "pwsh -Command \"Get-Content SCHEMA_VERSION\""
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.1.1",
    "lefthook": "^1.11.0"
  }
}
